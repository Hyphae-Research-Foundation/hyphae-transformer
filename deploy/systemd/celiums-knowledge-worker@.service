[Unit]
Description=Celiums knowledge one-shot worker for %i
After=network-online.target

[Service]
Type=oneshot
User=celiums-%i
Group=celiums-%i
UMask=0077
ExecStart=/opt/celiums/bin/celiums-knowledge worker-once --config /etc/celiums/%i.json
TimeoutStartSec=90
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
ReadWritePaths=/var/lib/celiums/%i /var/lib/node_exporter/textfile_collector
